<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>Microsoft.Extensions.AI IChatClient over a SharpMind chat session: run local models behind the standard .NET AI abstractions, with client-side tool calling.</Description>
    <PackageTags>LLM; C#; Inference; IChatClient; Microsoft.Extensions.AI</PackageTags>
    <ApplicationIcon>SharpMind.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="SharpMind.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" Version="10.9.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SharpMind.Inference\SharpMind.Inference.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SharpMind.Tests" />
  </ItemGroup>

</Project>
